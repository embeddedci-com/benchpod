		(uuid "30c4a4a3-1cae-47f7-806f-444f3ca29558")
	)
	(text "CN1: FFC to the digital board CN1 (module link), C5123103. TOP side, same orientation as the\ndigital CN1 (opening toward the board-edge cut). The cable U-turns through the cut, so the\npin order is straight: pin N here = digital CN1 pin N.\nPin 21 = MOD_PRESENT# (tied to GND: module present). Pin 20 = MOD_RESET#, pin 23 = MOD_SPARE (unused)."
		(exclude_from_sim no)
		(at 190.5 149.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "48fd2d19-20b8-4ed4-ad79-04057c9e8f60")
	)
	(text "U61: module ID + calibration EEPROM (24C32, 0x50). WP = GND (writable). Pull-ups on the digital board."
		(exclude_from_sim no)
		(at 259.08 118.11 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5b91e3d7-1fe5-4726-b6e1-6ba31783316a")
	)
